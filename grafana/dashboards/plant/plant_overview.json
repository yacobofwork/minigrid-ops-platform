{
  "uid": "minigrid-plant-overview",
  "title": "Mini-Grid O&M · 电站整体运行总览 (Plant Operations Overview)",
  "tags": [
    "minigrid",
    "plant"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "postgres",
          "uid": "TimescaleDB"
        },
        "definition": "SELECT DISTINCT site_id FROM telemetry ORDER BY site_id",
        "includeAll": true,
        "label": "站点 Site",
        "multi": true,
        "name": "site",
        "query": "SELECT DISTINCT site_id FROM telemetry ORDER BY site_id",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "当前总发电功率 (Generation Now: PV + Genset)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(power_kw), 0) AS total_kw FROM (SELECT DISTINCT ON (site_id, device_id) site_id, device_id, power_kw FROM telemetry WHERE ts > now() - interval '5 min' AND device_id IN ('PV-01','GEN-01') AND site_id IN ($site) ORDER BY site_id, device_id, ts DESC) latest",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "今日发电量 (Energy Today)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(max(energy_kwh) - min(energy_kwh), 0) AS kwh_today FROM telemetry WHERE ts::date = (now() AT TIME ZONE 'UTC')::date AND device_id = 'PV-01' AND site_id IN ($site)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "电池 SOC · 各站点 (Battery SOC)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT site_id AS metric, soc_pct AS value FROM (SELECT site_id, soc_pct, row_number() OVER (PARTITION BY site_id ORDER BY ts DESC) rn FROM telemetry WHERE ts > now() - interval '10 min' AND device_id = 'BAT-01' AND site_id IN ($site)) t WHERE rn = 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "故障设备数 (Devices in Fault)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT site_id) AS faults FROM telemetry WHERE fault_code IS NOT NULL AND ts > now() - interval '5 min' AND site_id IN ($site)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "mappings": [
          {
            "type": "value",
            "options": {
              "0": {
                "text": "正常 ALL OK",
                "color": "green"
              }
            }
          }
        ],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "各站点功率趋势 (Power Trend per Site)",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", site_id AS metric, sum(power_kw) AS value FROM telemetry WHERE $__timeFilter(ts) AND device_id IN ('PV-01','GEN-01') AND site_id IN ($site) GROUP BY ts, site_id ORDER BY ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "kW"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "今日分时发电 (Hourly Energy · 站点求和)",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS \"time\", COALESCE(SUM(energy_delta), 0) AS kwh FROM (SELECT time_bucket('1 hour', ts) AS bucket, site_id, MAX(energy_kwh) - MIN(energy_kwh) AS energy_delta FROM telemetry WHERE ts > now() - interval '24 hours' AND device_id = 'PV-01' AND site_id IN ($site) GROUP BY bucket, site_id) d GROUP BY bucket ORDER BY bucket",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "kW"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "barWidth": 0.7,
        "groupWidth": 0.7
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "变压器电压 / 光伏组件温度 (Voltage & Temperature)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", site_id || ' · V' AS metric, voltage_v AS value FROM telemetry WHERE $__timeFilter(ts) AND device_id = 'TR-01' AND site_id IN ($site) ORDER BY ts",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", site_id || ' · °C' AS metric, temp_c AS value FROM telemetry WHERE $__timeFilter(ts) AND device_id = 'PV-01' AND site_id IN ($site) ORDER BY ts",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "最近故障事件 (Recent Fault Events)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"时间 Time\", site_id AS \"站点 Site\", device_id AS \"设备 Device\", fault_code AS \"故障码 Code\", power_kw AS \"当时功率 kW\" FROM telemetry WHERE fault_code IS NOT NULL AND site_id IN ($site) ORDER BY ts DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}