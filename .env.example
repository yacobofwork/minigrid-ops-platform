# =============================================================================
# Mini-Grid O&M Platform — 环境变量模板
# 复制为 .env 后按需修改:  cp .env.example .env
# 注意: .env 已被 .gitignore 忽略，切勿把真实密码提交到仓库
# =============================================================================

# --- 数据库 ---
POSTGRES_USER=ops
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=minigrid
TSDB_PORT=5432

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_prod
GRAFANA_PORT=3000

# --- 告警邮件（Grafana SMTP）---
# 收件人（多个用逗号分隔）
ALERT_EMAIL_TO=ywang@saba.energy
# SMTP 服务配置。Gmail 示例（需开启两步验证并创建应用专用密码）：
#   SMTP_HOST=smtp.gmail.com:587
#   SMTP_USER=yacobofwork@gmail.com
#   SMTP_PASSWORD=<16位应用专用密码，不是Gmail登录密码>
#   应用专用密码生成: https://myaccount.google.com/apppasswords
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=yacobofwork@gmail.com
SMTP_PASSWORD=
SMTP_FROM=yacobofwork@gmail.com
# 自签名证书时设 true
SMTP_SKIP_VERIFY=false

# --- Odoo ---
ODOO_PORT=8069
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo_db_change_me

# --- Odoo 告警自动同步（odoo-sync 服务）---
# 配置后 Grafana 告警自动生成 Odoo 工单；留空则同步服务静默待机
# 本地社区版: ODOO_URL=http://odoo:8069, ODOO_DB=saba_minigrid, 账号的 API Key
# Odoo Online 企业版试用: ODOO_URL=https://saba-test.odoo.com, ODOO_DB=saba-test
ODOO_URL=http://odoo:8069
ODOO_DB=saba_minigrid
ODOO_EMAIL=yacobofwork@gmail.com
ODOO_API_KEY=
ODOO_TEAM=Minigrid O&M
ODOO_PROJECT=Minigrid O&M
SYNC_INTERVAL_SEC=60

# --- 采集服务 ---
# 数据源驱动: simulator(模拟) | modbus | mqtt
SOURCE_DRIVER=simulator
# 监控的站点列表（逗号分隔）
SITES=SITE-01,SITE-02,SITE-03
# 采集轮询间隔（秒）
POLL_INTERVAL_SEC=5

# --- 看门狗 ---
# 心跳文件超过该秒数未更新则判定采集服务异常并重启
HEARTBEAT_MAX_AGE_SEC=90
CHECK_INTERVAL_SEC=30
# 可选：告警 Webhook（PagerDuty / Slack / 自建），留空则只记日志
ALERT_WEBHOOK_URL=

# --- 备份 ---
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7

# --- 通用 ---
TZ=Africa/Lagos
LOG_LEVEL=INFO
